# Database connection string for Prisma ORM
# Update with your actual PostgreSQL credentials
DATABASE_URL="postgresql://user:password@localhost:5432/payslip"

# NextAuth.js secret for session encryption
# Generate a secure random secret using one of these methods:
# - macOS/Linux: openssl rand -base64 32
# - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# - Online: https://generate-secret.vercel.app/32
# IMPORTANT: Never commit your actual secret to version control
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Export token expiration (in days)
# Default: 30 days
# Share links will automatically expire after this many days to limit privacy exposure
EXPORT_TOKEN_EXPIRATION_DAYS=30
